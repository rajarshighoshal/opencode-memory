// Merge this into the `mcp` block of ~/.config/opencode/opencode.jsonc.
// Replace {{MEMORY_BIN}}, {{GLOBAL_DIR}}, {{GLOBAL_DB}} with the values install.sh prints.
//
// {{MEMORY_BIN}} is the opencode-memory binary itself — `opencode-memory` if it's on
// PATH (cargo install / release installer), otherwise its absolute path. The binary
// is self-contained: it anchors project memory to the repo root, starts the local
// llama.cpp embedding server on demand, and runs its own weekly maintenance — no
// wrapper needed. Every env var below is an OPTIONAL override of a working default
// (global.db under ~/.config/opencode/memory, llama.cpp on :11434, dim 2560); for a
// different embedding model, set MCP_EXTERNAL_EMBEDDING_MODEL + _DIM (see README).
{
  "mcp": {
    "memory-global": {
      "type": "local",
      "command": ["{{MEMORY_BIN}}", "global"],
      "environment": {
        "MCP_MEMORY_BASE_DIR": "{{GLOBAL_DIR}}",
        "MCP_MEMORY_SQLITE_PATH": "{{GLOBAL_DB}}",
        "MCP_EXTERNAL_EMBEDDING_URL": "http://localhost:11434/v1/embeddings",
        "MCP_EXTERNAL_EMBEDDING_MODEL": "qwen3-embedding-4b"
      },
      "enabled": true
    },
    "memory-project": {
      "type": "local",
      "command": ["{{MEMORY_BIN}}", "project"],
      "environment": {
        "MCP_EXTERNAL_EMBEDDING_URL": "http://localhost:11434/v1/embeddings",
        "MCP_EXTERNAL_EMBEDDING_MODEL": "qwen3-embedding-4b"
      },
      "enabled": true
    }
  }
}
