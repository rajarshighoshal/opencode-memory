#!/usr/bin/env bash
# pre-push gate — never let uncompiled / clippy-dirty / syntactically-broken code
# reach the remote. (This is the check that was missing when uncompiled Rust once
# reached main: an agent pushed from a shell with no `cargo` on PATH.)
#
# Versioned under .githooks/ and activated via `git config core.hooksPath .githooks`
# (install.sh does this). Applies to every committer on this machine.
#
# Runs:
#   - bash -n on the wrapper + *.sh                         (always, cheap)
#   - cargo build + test + clippy -D warnings on rust-memory  (only when the push
#     touches rust-memory/; blocks if cargo is missing so an unverifiable Rust
#     change can't slip through)
# Override in a genuine emergency with:  git push --no-verify
set -uo pipefail

repo="$(git rev-parse --show-toplevel)"
# Make cargo reachable even if the caller's PATH lacks it (the original footgun).
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

fail=0
zero="0000000000000000000000000000000000000000"

# Does any pushed commit touch rust-memory/? (pre-push gets ref updates on stdin)
rust_touched=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                              # new branch: check the tip commit
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^rust-memory/'; then
    rust_touched=1
  fi
done

# --- shell syntax gate (always) ---
for s in "$repo"/*.sh "$repo/memory-mcp"; do
  [ -f "$s" ] || continue
  bash -n "$s" 2>/dev/null || { echo "pre-push: bash syntax error in $s" >&2; fail=1; }
done

# --- rust gate (only when rust-memory/ is part of the push) ---
if [ "$rust_touched" = "1" ]; then
  if command -v cargo >/dev/null 2>&1; then
    echo "pre-push: rust-memory changed — cargo build + test + clippy..." >&2
    if ! ( cd "$repo/rust-memory" \
           && cargo build  --release --quiet \
           && cargo test   --release --quiet \
           && cargo clippy --release --quiet -- -D warnings ); then
      echo "pre-push: rust build/test/clippy FAILED — fix before pushing." >&2
      fail=1
    fi
  else
    echo "pre-push: BLOCKED — rust-memory changed but cargo is not on PATH, so this" >&2
    echo "          push cannot be verified. Install Rust (https://rustup.rs) or push" >&2
    echo "          from a shell with cargo. (This is the exact gap that let uncompiled" >&2
    echo "          code reach main.)" >&2
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: checks failed — push aborted. Override (NOT recommended): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: checks passed."
exit 0
