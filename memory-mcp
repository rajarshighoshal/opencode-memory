#!/usr/bin/env bash
# memory-mcp — thin compatibility shim.
#
# The opencode-memory binary is now fully self-contained: it anchors project
# memory to the repo root, lazily starts the llama.cpp embedding server, and runs
# its own weekly backup / maintenance / association-graph consolidation. So this
# wrapper only locates the binary and execs it — kept so existing MCP configs that
# point here keep working. New setups can point their MCP client straight at
# `opencode-memory <global|project>` (on PATH or an absolute path); no wrapper needed.
set -euo pipefail

scope="${1:-}"
case "$scope" in
  global|project) ;;
  *) echo "usage: $0 global|project" >&2; exit 64 ;;
esac

# Resolve this script's REAL directory (following symlinks) to find the binary
# built in-tree, then fall back to one on PATH.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
script_dir="$(cd -P "$(dirname "$_src")" && pwd)"
rust_bin="$script_dir/rust-memory/target/release/opencode-memory"
[[ -x "$rust_bin" ]] || rust_bin="$(command -v opencode-memory || echo "$rust_bin")"

if [[ ! -x "$rust_bin" ]]; then
  echo "opencode-memory not found. Build it:" >&2
  echo "  ( cd \"$script_dir/rust-memory\" && cargo build --release )" >&2
  echo "or install it:  cargo install opencode-memory" >&2
  exit 127
fi

exec "$rust_bin" "$scope"
